import requests
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, ContextTypes, filters

TELEGRAM_TOKEN = '7838466489:AAFJgEJhNBw_XofBzM3urJouMf6nFyxyj4M'
WEATHER_API_KEY = 'b9bd18c408c2ead84ab367ee035774f0'

def get_weather(city):
    url = f"https://api.openweathermap.org/data/2.5/weather?q={city}&appid={WEATHER_API_KEY}&units=metric&lang=ru"
    try:
        response = requests.get(url)
        data = response.json()

        if data.get("cod") != 200:
            return "❌ Город не найден. Проверь написание."

        weather_desc = data["weather"][0]["description"]
        temp = data["main"]["temp"]
        feels_like = data["main"]["feels_like"]
        humidity = data["main"]["humidity"]
        pressure = data["main"]["pressure"]
        wind_speed = data["wind"]["speed"]

        return (
            f"📍 *Погода в {city.title()}*\n"
            f"🌤 {weather_desc.capitalize()}\n"
            f"🌡 Температура: {temp}°C (ощущается как {feels_like}°C)\n"
            f"💧 Влажность: {humidity}%\n"
            f"🌬 Ветер: {wind_speed} м/с\n"
            f"🔽 Давление: {pressure} гПа"
        )

    except Exception as e:
        return "⚠️ Ошибка при получении погоды. Попробуй позже."


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Привет! 👋\nПросто напиши название города, чтобы узнать погоду.\nНапример: *Алматы*, *Ополе*(Для Кати), *Варшава*.",
        parse_mode="Markdown"
    )


async def handle_city(update: Update, context: ContextTypes.DEFAULT_TYPE):
    city = update.message.text.strip()
    weather_info = get_weather(city)
    await update.message.reply_text(weather_info, parse_mode="Markdown")


if __name__ == '__main__':
    app = ApplicationBuilder().token(TELEGRAM_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_city))

    print("🌍 Бот запущен. Введите название города...")
    app.run_polling()
